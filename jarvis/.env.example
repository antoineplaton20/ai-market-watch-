# Copiez ce fichier en jarvis/.env puis remplissez-le (./jarvis.sh installer le fait pour vous).

# Obligatoire : clé API Claude (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Telegram : créez un NOUVEAU bot avec @BotFather (ne réutilisez pas celui des bots de trading)
JARVIS_TELEGRAM_TOKEN=
# Votre chat_id (Jarvis vous le donne au premier message si vous le laissez vide). Plusieurs : 123,456
JARVIS_TELEGRAM_CHAT_IDS=

# Vocaux : clé Groq (gratuite, la même que LLM_API_KEY des bots) pour transcrire vos messages vocaux
GROQ_API_KEY=

# Réglages facultatifs
# JARVIS_MODEL=claude-opus-5
# JARVIS_EFFORT=high                 # low | medium | high | xhigh | max (plus haut = plus réfléchi, plus cher)
# JARVIS_VOICE_REPLIES=auto          # auto | on | off
# JARVIS_TTS_VOICE=fr-FR-HenriNeural # ou fr-FR-DeniseNeural, fr-FR-RemyMultilingualNeural...
# JARVIS_USER_NAME=Monsieur
# JARVIS_TZ=Europe/Paris
