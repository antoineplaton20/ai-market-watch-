# Fichier .env de la plateforme (serveur Hetzner). Il est créé par « bots config » : ne le remplis
# à la main que pour les réglages facultatifs. Ne JAMAIS le partager ni le mettre sur Git.

# ======================= BOT PRINCIPAL (écrit par « bots config ») =======================
# MODE : demo (argent fictif) | testnet | reel
MODE=demo
BINANCE_API_KEY=
BINANCE_API_SECRET=
CAPITAL_MAX_USDT=1000
ANTHROPIC_API_KEY=
COINGECKO_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ======================= MOTEUR V17 (tout est facultatif) =======================
# Par défaut : portefeuille FICTIF de la v17 sur les vrais prix publics de Binance, aucun ordre.
# V17_MODE=paper               # paper | demo | testnet | live
# V17_SYMBOLS=BTC/USDT         # ou : bots v17-symboles BTC/USDT,ETH/USDT
# V17_TIMEFRAME=15m            # une décision par bougie fermée de cette durée
# V17_INTERVAL_SECONDS=60      # contrôle des prix et de la protection
# V17_STOP_LOSS_PCT=3          # protection : vente si -3 % sous le prix d'achat (0 = aucune)
# V17_SCORE_MIN=0.65           # accord minimal des votes pour agir
# PAPER_CASH_USDT=10000        # caisse fictive de départ de la v17
# MAX_ORDER_USDT=100
# MAX_POSITION_USDT=250
# MAX_DAILY_LOSS_USDT=50
# KILL_SWITCH=0                # 1 = la v17 ne passe plus aucun ordre (même fictif)
# V17_AUTO_RECONCILE=1         # démo/testnet : blocage « rapprochement requis » levé seul en interrogeant Binance
# V17_SLIPPAGE_PAUSE_MIN=60    # pause des achats après un glissement excessif, en minutes (0 = jusqu'à /v17 reprise)
# V17_API_PORT=8080            # API de supervision, 127.0.0.1 uniquement
#
# Compte démo Binance : « bots v17-demo » règle V17_MODE=demo et V17_DEMO_ONLY=1 (démo uniquement).
# Clés : V17_API_KEY / V17_API_SECRET si remplies, sinon celles du bot principal s'il est en MODE=demo.
# testnet : clés sandbox propres à la v17. live : clés d'un sous-compte dédié (jamais celles du bot principal).
# V17_DEMO_ONLY=0
# V17_API_KEY=
# V17_API_SECRET=
# Argent réel (live) : en plus, LIVE_TRADING_ENABLED=1. Non recommandé : voir V17_PLATEFORME.md.
# LIVE_TRADING_ENABLED=0

# V17.8 : contrôles du moteur v17 uniquement (pas du bot principal).
# Risque estimé par opération : stop + frais + glissement ; pas une perte maximale garantie.
V17_RISK_PER_TRADE_PCT=0.5
V17_MAX_DRAWDOWN_PCT=10
V17_MAX_POSITIONS=3
V17_COOLDOWN_BARS=4
