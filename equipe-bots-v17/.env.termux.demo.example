# ============================================================
# EQUIPE-BOTS V17 — BINANCE DEMO UNIQUEMENT
# À copier vers .env puis remplir sur le serveur.
# NE PARTAGE JAMAIS ce fichier après avoir ajouté les clés.
# ============================================================
V17_DEMO_ONLY=1
V17_MODE=demo
V17_API_KEY=
V17_API_SECRET=
V17_SYMBOLS=BTC/USDT,ETH/USDT
V17_TIMEFRAME=15m
V17_INTERVAL_SECONDS=60
V17_API_HOST=127.0.0.1
V17_API_PORT=8080

# Garde-fous
LIVE_TRADING_ENABLED=0
KILL_SWITCH=0
V17_CAPITAL_MAX_USDT=1000
MAX_ORDER_USDT=100
MAX_POSITION_USDT=250
MAX_DAILY_LOSS_USDT=50
MAX_SLIPPAGE_PCT=0.25
MAX_OPEN_ORDERS=5
V17_SCORE_MIN=0.65
V17_STOP_LOSS_PCT=3

# Journal / base locale
OPS_DB=runtime/v17_ops.db
V17_LOG=runtime/v17.log

# Machine autonome sans jeton Telegram. (Sur la plateforme, la v17 utilise le Telegram du bot principal.)
V17_TELEGRAM=0
