#!/usr/bin/env bash
# Télécommande R5.2 : arguments transmis comme données, jamais évalués par le shell.
set -euo pipefail
DOSSIER=/home/bots/armee-or
[ "$(id -u)" -eq 0 ] || { echo 'Utilise Termius en root.'; exit 1; }
python_or() {
  runuser -u bots -- bash -c 'cd "$1"; shift; exec .venv/bin/python -m armee_or "$@"' _ "$DOSSIER" "$@"
}
CMD="${1:-aide}"
shift || true
case "${CMD,,}" in
  etat|rapport) python_or etat ;;
  recherche|diagnostic|registre|grands|levier|bilan|bibliotheque|bougies|veille|apprentissage|verif|brief|test|alerte|alertes)
    python_or "${CMD,,}" "$@" ;;
  go|gp|gip|eco|top|wei|corr|rv|niv|cot|des|risk|codes) python_or terminal "${CMD,,}" "$@" ;;
  demo)
    case "${1:-etat}" in
      on|off) python_or commande "demo_$1" ;;
      etat) python_or demo ;;
      *) echo 'or demo [etat|on|off]'; exit 2 ;;
    esac ;;
  marches)
    case "${1:-etat}" in
      etat) python_or marches ;;
      on|off|fermer|1000|normal) python_or commande "marches_$1" ;;
      *) echo 'or marches [etat|on|off|fermer|1000|normal]'; exit 2 ;;
    esac ;;
  video)
    case "${1:-etat}" in
      etat) python_or video
            if systemctl is-active --quiet armee-or-mt5-video; then echo '● armee-or-mt5-video en marche'
            else echo '● armee-or-mt5-video arrêté (or video installer, puis or video journal)'; fi ;;
      on|off|fermer) python_or commande "video_$1" ;;
      gain) [[ "${2:-}" =~ ^[0-9]{1,2}([.,][0-9]{1,2})?$ ]] || { echo 'Usage : or video gain 2 ($ par once)'; exit 2; }
            python_or commande "video_gain $2" ;;
      symbole) [[ "${2:-}" =~ ^[A-Za-z0-9._#-]{1,32}$ ]] || { echo 'Usage : or video symbole EURUSD (ou : or)'; exit 2; }
               python_or commande "video_symbole $2" ;;
      rejouer) python_or video rejouer ;;
      journal) journalctl -u armee-or-mt5-video -n 80 --no-pager ;;
      installer) bash "$DOSSIER/installer_video.sh" ;;
      compte) bash "$DOSSIER/installer_video.sh" compte ;;
      *) echo 'or video [etat|on|off|fermer|gain X|symbole X|rejouer|journal|installer|compte]'; exit 2 ;;
    esac ;;
  pause|reprise) python_or commande "${CMD,,}" ;;
  risque) python_or risque "$@" ;;
  sauvegarde) python_or sauvegarde ;;
  mt5)
    SOUS="${1:-etat}"; shift || true
    case "$SOUS" in
      etat) python_or mt5 ;;
      fermer|reprendre|profil|entrainement|gain|tendance|permis|agressif|rentable) python_or commande "mt5_$SOUS" "$@" ;;
      journal) journalctl -u armee-or-mt5 -n 80 --no-pager ;;
      *) echo 'or mt5 [etat|fermer|reprendre|profil|gain|journal]. Installation/compte : utiliser la procédure auditée.'; exit 2 ;;
    esac ;;
  journal) journalctl -u armee-or-chef -n 80 --no-pager ;;
  maj)
    # Dernière version publiée sur GitHub. La copie ROOT du contrôle de version (/var/lib/armee-or, posée à la
    # dernière installation) exige qu'elle soit plus récente : jamais de retour à une version plus ancienne. Puis
    # l'installateur de la nouvelle version teste sur ce serveur, sauvegarde et installe en pause.
    URL='https://github.com/antoineplaton20/ai-market-watch-/archive/refs/heads/claude/termius-binance-bot-optimization-g98ihl.tar.gz'
    CONTROLE=/var/lib/armee-or/deployer.py
    [ -f "$CONTROLE" ] || { echo "Contrôle de version absent : une fois, la ligne d'installation du LISEZMOI. Ensuite : or maj."; exit 1; }
    TMP=$(mktemp -d /root/armee-or-maj.XXXXXX); trap 'rm -rf "$TMP"' EXIT
    echo 'Téléchargement de la dernière version publiée…'
    curl -fsSL --retry 3 --max-time 900 "$URL" | tar -xz -C "$TMP" || { echo 'Téléchargement impossible (réseau ?). Réessaie : or maj'; exit 1; }
    NOUVEAU="$TMP/ai-market-watch--claude-termius-binance-bot-optimization-g98ihl/armee-or"
    { [ -f "$NOUVEAU/deployer.py" ] && [ -f "$NOUVEAU/PAQUET.json" ]; } || { echo 'Version publiée incomplète : rien installé.'; exit 1; }
    RC=0; python3 -I "$CONTROLE" comparer "$NOUVEAU/PAQUET.json" || RC=$?
    [ "$RC" -eq 0 ] || exit "$RC"
    python3 -I "$NOUVEAU/deployer.py" installer ;;
  maj-auto)
    # Lancée par le service root armee-or-maj (demande /or_maj sur Telegram) : même mise à jour, résultat sur Telegram.
    LOG=/var/log/armee-or-maj.log                    # journal root, hors du dossier modifiable par « bots »
    RC=0; "$0" maj < /dev/null > "$LOG" 2>&1 || RC=$?
    case "$RC" in
      0) RES='✅ Mise à jour installée (en pause : commandes pour reprendre ci-dessous).' ;;
      3) RES='ℹ️ Déjà à jour : rien installé.' ;;
      4) RES='⛔ La version publiée est plus ancienne que la tienne : rien installé.' ;;
      *) RES='❌ Mise à jour non installée : ton armée continue avec sa version actuelle. Envoie-moi ce message.' ;;
    esac
    FIN=$(tail -n 12 "$LOG" | sed 's/\x1b\[[0-9;]*m//g')
    runuser -u bots -- bash -c 'cd "$1" && exec .venv/bin/python -c "import sys; from armee_or import telegram; telegram.envoyer(sys.argv[1], True)" "$2"' \
      _ "$DOSSIER" "$RES"$'\n'"$FIN" || true ;;
  mettre-a-jour) echo 'Plus besoin de zip : or maj (Termius) ou /or_maj (Telegram).'; exit 2 ;;
  retour)
    [[ "${1:-}" =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || { echo "Usage : or retour IDENTIFIANT (affiché à l'installation, ex. 20261025T101500Z)"; exit 2; }
    python3 -I /var/lib/armee-or/deployer.py retour "$1" ;;
  restaurer) echo 'R3 : restauration de base suspendue ; une ancienne sauvegarde peut rejouer des commandes ou effacer des transactions. Utiliser le retour du code documenté.'; exit 2 ;;
  redemarrer) systemctl restart armee-or-flux armee-or-chef ;;   # le pont vidéo garde son compte et ses paniers
  arreter) systemctl stop armee-or-chef armee-or-flux; echo 'Chef et flux arrêtés. Le pont et les stops existants restent en place.' ;;
  demarrer) systemctl start armee-or-flux armee-or-chef ;;
  *) cat <<'AIDE'
Armée de l'or R5 — chaque équipe qui passe des ordres exige ton activation explicite.
  or marches         multi-marchés : forex, métaux, énergie, agricoles, indices, crypto (banc, permis, positions)
  or marches on|off  activer (achats sous permis, plafond R3 de 2 %) / arrêter les achats · or marches fermer
  or marches 1000    la démo imite un compte de 1 000 € (3 % par trade, 3 positions) · or marches normal : retour
  or video installer équipe vidéo : 2e compte DÉMO à fort levier (login, mot de passe, serveur tapés ici)
  or video           ses paniers et ses loteries · or video on|off|fermer · or video gain 2 · or video rejouer
  or video symbole EURUSD   autre marché pour l'équipe vidéo (or video symbole or : retour à l'or)
  or demo on         activer les ordres de test démo (sans preuve de rentabilité)
  or demo off        arrêter les nouvelles entrées expérimentales
  or demo            état et dernier motif d’attente
  or diagnostic      contrôles observés et blocages
  or mt5             compte démo et suivi des positions
  or registre        hypothèses et essais, sans permis automatique
  or grands 1        bibliothèque paginée
  or etat            rapport général
  or pause           suspendre les nouvelles positions papier et MT5
  or mt5 fermer      demander la fermeture des positions de l'armée
  or sauvegarde      copie cohérente locale et envoi Telegram configuré
  or maj             mettre à jour depuis GitHub (plus récente seulement, testée ici) · Telegram : /or_maj
  or retour ID       revenir à la version d'avant (identifiant affiché à l'installation)
  or journal         dernières lignes, sans rester bloqué dans le journal
  or go              terminal en direct, Ctrl+C pour sortir
AIDE
    ;;
esac
