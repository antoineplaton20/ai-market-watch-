#!/usr/bin/env bash
# TÉLÉCOMMANDE DU SERVEUR : tape « bots » pour voir la liste des commandes.
DOSSIER=/home/bots/equipe-bots
SERVICE=equipe-bots
V='\033[1;32m'; J='\033[1;33m'; R='\033[1;31m'; N='\033[0m'
en_bots() { runuser -u bots -- env HOME=/home/bots bash -c "cd '$DOSSIER' && $*"; }
lire_env() { local v; v=$(grep -E "^$1=" "$DOSSIER/.env" 2>/dev/null | tail -n 1 | cut -d= -f2-); echo "${v:-$2}"; }
regler_env() {   # regler_env NOM valeur : remplace ou ajoute la ligne dans .env, sans toucher au reste
  touch "$DOSSIER/.env"
  if grep -qE "^$1=" "$DOSSIER/.env"; then sed -i -E "s|^$1=.*|$1=$2|" "$DOSSIER/.env"; else echo "$1=$2" >> "$DOSSIER/.env"; fi
  chown bots:bots "$DOSSIER/.env"; chmod 600 "$DOSSIER/.env"
}
# Relance SANS FIN de chaque service (plantage, sortie inattendue, mémoire, moteur figé) : 15 s, puis attente
# croissante jusqu'à 5 min. StartLimitIntervalSec=0 : systemd n'abandonne jamais. Seul « systemctl stop »
# (bots arreter, bots v17-arreter...) arrête un service.
RELANCE='Restart=always
RestartSec=15
RestartSteps=6
RestartMaxDelaySec=300
'
service_principal() {   # bot principal (chien de garde lanceur.py) : unité réécrite à chaque mise à jour
  [ -f "$DOSSIER/lanceur.py" ] || return 0
  cat > /etc/systemd/system/$SERVICE.service << UNITE
[Unit]
Description=Equipe de bots crypto (chien de garde)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=bots
WorkingDirectory=$DOSSIER
ExecStart=$DOSSIER/.venv/bin/python lanceur.py
${RELANCE}KillSignal=SIGINT
TimeoutStopSec=60
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
UNITE
  systemctl daemon-reload
  systemctl enable $SERVICE > /dev/null 2>&1
}
SERVICE_TR=equipe-bots-tr
service_tr() {   # crée / met à jour le service de la veille Trade Republic et le (re)démarre
  if [ ! -f "$DOSSIER/veille_tr.py" ]; then
    systemctl disable --now $SERVICE_TR > /dev/null 2>&1; return 0
  fi
  cat > /etc/systemd/system/$SERVICE_TR.service << UNITE
[Unit]
Description=Veille Trade Republic (signaux manuels, aucun ordre)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=bots
WorkingDirectory=$DOSSIER
ExecStart=$DOSSIER/.venv/bin/python veille_tr.py
${RELANCE}Nice=10
MemoryMax=1200M
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
UNITE
  systemctl daemon-reload
  systemctl enable $SERVICE_TR > /dev/null 2>&1
  systemctl restart $SERVICE_TR
}
SERVICE_RENS=equipe-bots-renseignement
service_renseignement() {   # armée de renseignement : priorité BASSE (processeur, disque) pour ne jamais gêner le trading
  if [ ! -f "$DOSSIER/renseignement.py" ]; then
    systemctl disable --now $SERVICE_RENS > /dev/null 2>&1; return 0
  fi
  cat > /etc/systemd/system/$SERVICE_RENS.service << UNITE
[Unit]
Description=Armée de renseignement (recherche perpétuelle, aucun ordre)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=bots
WorkingDirectory=$DOSSIER
ExecStart=$DOSSIER/.venv/bin/python renseignement.py
${RELANCE}Nice=15
CPUQuota=50%
IOSchedulingClass=idle
MemoryMax=700M
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
UNITE
  systemctl daemon-reload
  systemctl enable $SERVICE_RENS > /dev/null 2>&1
  systemctl restart $SERVICE_RENS
}
SERVICE_MARCHES=equipe-bots-marches
service_marches() {   # crée / met à jour le service de la veille marchés mondiaux et le (re)démarre
  if [ ! -f "$DOSSIER/veille_marches.py" ]; then
    systemctl disable --now $SERVICE_MARCHES > /dev/null 2>&1; return 0
  fi
  cat > /etc/systemd/system/$SERVICE_MARCHES.service << UNITE
[Unit]
Description=Veille marchés mondiaux (presse, notes 0-5, aucun ordre)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=bots
WorkingDirectory=$DOSSIER
ExecStart=$DOSSIER/.venv/bin/python veille_marches.py
${RELANCE}Nice=10
MemoryMax=900M
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
UNITE
  systemctl daemon-reload
  systemctl enable $SERVICE_MARCHES > /dev/null 2>&1
  systemctl restart $SERVICE_MARCHES
}
SERVICE_V17=equipe-bots-v17
SERVICE_V17_API=equipe-bots-v17-api
service_v17() {   # crée / met à jour le service du moteur v17 (portefeuille fictif, vrais prix) et le (re)démarre
  if [ ! -d "$DOSSIER/v17_ops" ]; then
    systemctl disable --now $SERVICE_V17 $SERVICE_V17_API > /dev/null 2>&1; return 0
  fi
  cat > /etc/systemd/system/$SERVICE_V17.service << UNITE
[Unit]
Description=Moteur V17 (portefeuille fictif sur vrais prix Binance, signaux Telegram)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=bots
WorkingDirectory=$DOSSIER
ExecStart=$DOSSIER/.venv/bin/python -m v17_ops
${RELANCE}WatchdogSec=900
NotifyAccess=main
KillSignal=SIGINT
TimeoutStopSec=30
Nice=10
MemoryMax=600M
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
UNITE
  systemctl daemon-reload
  systemctl enable $SERVICE_V17 > /dev/null 2>&1
  systemctl restart $SERVICE_V17
}
service_v17_api() {   # API de supervision v17 : lecture seule, écoute UNIQUEMENT sur 127.0.0.1 (jamais Internet)
  [ -d "$DOSSIER/v17_ops" ] || return 1
  cat > /etc/systemd/system/$SERVICE_V17_API.service << UNITE
[Unit]
Description=API de supervision V17 (lecture seule, 127.0.0.1)
After=network-online.target
StartLimitIntervalSec=0

[Service]
User=bots
WorkingDirectory=$DOSSIER
ExecStart=$DOSSIER/.venv/bin/python -m uvicorn v17_ops.api.app:app --host 127.0.0.1 --port $(lire_env V17_API_PORT 8080)
${RELANCE}MemoryMax=300M
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
UNITE
  systemctl daemon-reload
  systemctl enable $SERVICE_V17_API > /dev/null 2>&1
  systemctl restart $SERVICE_V17_API
}
journal_v17() { local j; j=$(lire_env V17_LOG v17.log); case "$j" in /*) echo "$j" ;; *) echo "$DOSSIER/$j" ;; esac; }
relancer_v17_si_actif() {   # après une mise à jour : on relance la v17 (et la veille marchés) si elles étaient en service
  if systemctl is-enabled --quiet $SERVICE_MARCHES 2> /dev/null; then service_marches; fi
  if systemctl is-enabled --quiet $SERVICE_RENS 2> /dev/null; then service_renseignement; fi
  if systemctl is-enabled --quiet $SERVICE_V17 2> /dev/null; then service_v17; fi
  if systemctl is-enabled --quiet $SERVICE_V17_API 2> /dev/null; then service_v17_api || true; fi
}
[ "$(id -u)" -eq 0 ] || { echo "Lance les commandes « bots » en root (tu l'es par défaut)."; exit 1; }

case "${1:-aide}" in
  etat)
    systemctl is-active --quiet $SERVICE && echo -e "${V}● Bot Binance en marche${N}" || echo -e "${R}● Bot Binance arrêté${N}"
    systemctl is-active --quiet $SERVICE_TR && echo -e "${V}● Veille Trade Republic en marche${N}" \
      || echo -e "${J}● Veille Trade Republic arrêtée${N} (bots tr-demarrer)"
    systemctl is-active --quiet $SERVICE_V17 && echo -e "${V}● Moteur v17 en marche${N}" \
      || echo -e "${J}● Moteur v17 arrêté${N} (bots v17-demarrer)"
    systemctl is-active --quiet $SERVICE_MARCHES && echo -e "${V}● Veille marchés mondiaux en marche${N}" \
      || echo -e "${J}● Veille marchés mondiaux arrêtée${N} (bots marches-demarrer)"
    systemctl is-active --quiet $SERVICE_RENS && echo -e "${V}● Armée de renseignement en marche${N}" \
      || echo -e "${J}● Armée de renseignement arrêtée${N} (bots renseignement-demarrer)"
    echo; tail -n 20 "$DOSSIER/bot.log" 2>/dev/null
    echo -e "\n--- veille TR ---"; tail -n 5 "$DOSSIER/tr.log" 2>/dev/null
    echo -e "\n--- moteur v17 ---"; tail -n 5 "$(journal_v17)" 2>/dev/null ;;
  journal)
    echo "Journal en direct (Ctrl+C pour quitter ; dans Termius : touche Ctrl puis C)"; tail -n 50 -f "$DOSSIER/bot.log" ;;
  demarrer)   systemctl start $SERVICE && echo -e "${V}Bot démarré.${N}" ;;
  arreter)    systemctl stop $SERVICE && echo -e "${J}Bot arrêté. Les stops restent actifs chez Binance.${N}" ;;
  redemarrer) systemctl restart $SERVICE && echo -e "${V}Bot redémarré.${N}" ;;
  config)
    bash "$DOSSIER/configurer.sh" && systemctl restart $SERVICE && echo -e "${V}Configuration appliquée, bot redémarré.${N}" ;;
  unite)
    case "${2:-}" in 15m|1h|4h) ;; *) echo "Usage : bots unite 15m | 1h | 4h"; exit 1 ;; esac
    # v11 : l'unité de signal se règle dans .env (TIMEFRAME_SIGNAL) ; config.py n'est plus lu pour ça.
    regler_env TIMEFRAME_SIGNAL "$2"
    sed -i -E "s/^(UNITE_BOUGIE = )\"[^\"]*\"/\1\"$2\"/" "$DOSSIER/config.py"
    echo -e "${V}Unité de signal réglée sur $2${N} (filtres : tendance $(lire_env TIMEFRAME_TREND 1h), régime $(lire_env TIMEFRAME_REGIME 4h), entrée $(lire_env TIMEFRAME_ENTRY 5m))."
    [ "$2" = 15m ] || echo -e "${J}Note v11 : avec un signal en $2, le filtre multi-unités vérifie deux fois une même unité ou une unité plus fine. C'est permis, mais l'architecture v11 est pensée pour 15m.${N}"
    systemctl restart $SERVICE && echo -e "${V}Bot redémarré.${N} Pense à relancer l'évolution : bots evolution" ;;
  verifier)   en_bots ".venv/bin/python verifier.py" ;;
  backtest)   echo "Backtest comparatif (peut durer longtemps la première fois)..."; en_bots ".venv/bin/python backtest.py --comparer" ;;
  evolution)
    en_bots "nohup .venv/bin/python evolution.py > evolution_console.log 2>&1 &"
    echo -e "${V}Évolution lancée en arrière-plan : le bilan arrivera sur Telegram.${N}" ;;
  recherche)
    en_bots "nohup .venv/bin/python recherche.py > recherche_console.log 2>&1 &"
    echo -e "${V}Recherche fondamentale lancée : le bilan arrivera sur Telegram.${N}" ;;
  preparer)
    en_bots "nohup .venv/bin/python preparer.py > preparation.log 2>&1 &"
    echo -e "${V}Préparation lancée (tests, backtest, évolution) : les résultats arriveront sur Telegram.${N}" ;;
  sauvegarde)
    en_bots ".venv/bin/python -c 'import securite; print(securite.sauvegarde_quotidienne({}) or \"déjà faite aujourd hui\")'"
    ls -lh "$DOSSIER/sauvegardes" 2>/dev/null | tail -n 10 ;;
  registre)   en_bots ".venv/bin/python -c 'import registre; print(registre.verifier())'" ;;
  tr-test)
    echo "Test en direct de la veille Trade Republic (liste officielle + Yahoo), 1 à 2 minutes..."
    en_bots ".venv/bin/python veille_tr.py --test" ;;
  tr-univers)
    if [ -n "${2:-}" ]; then
      [ -f "$2" ] || { echo -e "${R}Fichier introuvable : $2${N}"; exit 1; }
      install -o bots -g bots -m 644 "$2" "$DOSSIER/univers_officiel.pdf"
      en_bots ".venv/bin/python veille_tr.py --univers univers_officiel.pdf"
    else
      en_bots ".venv/bin/python veille_tr.py --univers"
    fi ;;
  tr-montant)
    [[ "${2:-}" =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "Usage : bots tr-montant 500   (montant en euros de tes ordres TR)"; exit 1; }
    regler_env TR_MONTANT_ORDRE_EUR "$2"
    systemctl restart $SERVICE_TR
    echo -e "${V}Montant par ordre Trade Republic : $2 €${N} (sert à calculer le poids des frais de 1 € par ordre)." ;;
  tr-journal)
    echo "Journal de la veille TR en direct (Ctrl+C pour quitter)"; tail -n 50 -f "$DOSSIER/tr.log" ;;
  tr-demarrer) service_tr && echo -e "${V}Veille Trade Republic démarrée.${N}" ;;
  tr-arreter)
    systemctl disable --now $SERVICE_TR > /dev/null 2>&1; echo -e "${J}Veille Trade Republic arrêtée (le bot Binance continue).${N}" ;;
  renseignement-test)
    echo "Test de chaque bot de l'armée de renseignement (2 à 4 minutes)..."
    en_bots ".venv/bin/python renseignement.py --test" ;;
  renseignement-demarrer)
    service_renseignement && sleep 3 && systemctl is-active --quiet $SERVICE_RENS \
      && echo -e "${V}Armée de renseignement déployée (priorité basse : elle ne ralentit jamais le trading).
  Premières infos dans 5 à 10 minutes. Sur Telegram : /renseignement${N}" \
      || { echo -e "${R}L'armée ne démarre pas :${N}"; tail -n 20 "$DOSSIER/renseignement.log" 2>/dev/null; } ;;
  renseignement-arreter)
    systemctl disable --now $SERVICE_RENS > /dev/null 2>&1; echo -e "${J}Armée de renseignement arrêtée.${N}" ;;
  renseignement-etat)
    en_bots ".venv/bin/python -c 'import lecture_renseignement as L; print(L.texte_statut())'"
    echo; en_bots "sqlite3 -readonly runtime/renseignement.db \"SELECT printf('%-48s %5d infos  %s', nom, faits, COALESCE(erreur, 'ok')) FROM bots ORDER BY famille, nom\" 2>/dev/null" ;;
  renseignement-journal)
    echo "Journal de l'armée de renseignement en direct (Ctrl+C pour quitter)"; tail -n 50 -f "$DOSSIER/renseignement.log" ;;
  marches-test)
    echo "Test de la veille marchés : presse mondiale, Yahoo Finance, 3 notes d'essai (1 à 2 minutes)..."
    en_bots ".venv/bin/python veille_marches.py --test" ;;
  marches-demarrer)
    service_marches && sleep 3 && systemctl is-active --quiet $SERVICE_MARCHES \
      && echo -e "${V}Veille marchés démarrée. Sur Telegram : /marches · /briefing · /note LVMH${N}" \
      || { echo -e "${R}La veille marchés ne démarre pas :${N}"; tail -n 20 "$DOSSIER/marches.log" 2>/dev/null; } ;;
  marches-arreter)
    systemctl disable --now $SERVICE_MARCHES > /dev/null 2>&1; echo -e "${J}Veille marchés arrêtée.${N}" ;;
  marches-journal)
    echo "Journal de la veille marchés en direct (Ctrl+C pour quitter)"; tail -n 50 -f "$DOSSIER/marches.log" ;;
  marches-note)
    [ -n "${2:-}" ] || { echo "Usage : bots marches-note LVMH   (nom, ticker Yahoo comme MC.PA, ISIN, ou bitcoin)"; exit 1; }
    shift; en_bots ".venv/bin/python veille_marches.py --note $(printf '%q ' "$@")" ;;
  marches-portefeuille|marches-suivre)
    VAR=MARCHES_PORTEFEUILLE; [ "$1" = marches-suivre ] && VAR=MARCHES_SUIVIS
    LISTE="$(echo "${2:-}" | tr -d ' ')"
    [[ "$LISTE" =~ ^[A-Za-z0-9.^=_-]+(,[A-Za-z0-9.^=_-]+)*$ || "$LISTE" = aucun ]] \
      || { echo "Usage : bots $1 MC.PA,AAPL,BTC,FR0000121014   (ou : bots $1 aucun)"; exit 1; }
    [ "$LISTE" = aucun ] && LISTE=""
    regler_env $VAR "$LISTE"
    echo -e "${V}$VAR = ${LISTE:-(vide)}${N}"
    systemctl is-enabled --quiet $SERVICE_MARCHES 2> /dev/null && systemctl restart $SERVICE_MARCHES \
      && echo "Veille marchés redémarrée : notes recalculées dans les minutes qui viennent." ;;
  v17-etat)
    systemctl is-active --quiet $SERVICE_V17 && echo -e "${V}● Moteur v17 en marche${N}" || echo -e "${R}● Moteur v17 arrêté${N} (bots v17-demarrer)"
    systemctl is-active --quiet $SERVICE_V17_API && echo -e "${V}● API v17 en marche (127.0.0.1:$(lire_env V17_API_PORT 8080))${N}"
    echo; en_bots ".venv/bin/python -c 'from v17_ops import rapport; print(rapport.texte_statut())'"
    echo -e "\n--- journal v17 ---"; tail -n 15 "$(journal_v17)" 2>/dev/null ;;
  v17-journal)
    echo "Journal du moteur v17 en direct (Ctrl+C pour quitter)"; tail -n 50 -f "$(journal_v17)" ;;
  v17-demarrer)
    service_v17 && sleep 3 && systemctl is-active --quiet $SERVICE_V17 \
      && echo -e "${V}Moteur v17 démarré (portefeuille fictif sur les vrais prix Binance). Suivi : /v17 sur Telegram.${N}" \
      || { echo -e "${R}Le moteur v17 ne démarre pas :${N}"; tail -n 20 "$(journal_v17)" 2>/dev/null; } ;;
  v17-demo-test)
    echo "Test de connexion de la v17 au compte démo Binance (aucun ordre)..."
    en_bots ".venv/bin/python -m v17_ops.verif_demo" ;;
  v17-demo)
    [ -d "$DOSSIER/v17_ops" ] || { echo -e "${R}Version sans moteur v17 : fais d'abord la mise à jour.${N}"; exit 1; }
    AVANT_MODE=$(lire_env V17_MODE paper); AVANT_SEUL=$(lire_env V17_DEMO_ONLY 0)
    regler_env V17_MODE demo; regler_env V17_DEMO_ONLY 1
    echo "Test de connexion au compte démo Binance (aucun ordre)..."
    if en_bots ".venv/bin/python -m v17_ops.verif_demo"; then
      service_v17 && sleep 3
      systemctl is-active --quiet $SERVICE_V17 \
        && echo -e "${V}✔ v17 en mode DÉMO : vrais ordres sur le compte démo Binance (argent fictif), budget v17 séparé.
  Suivi : /v17 sur Telegram · retour au portefeuille fictif : bots v17-fictif${N}" \
        || { echo -e "${R}Le moteur v17 ne démarre pas :${N}"; tail -n 20 "$(journal_v17)" 2>/dev/null; }
    else
      regler_env V17_MODE "$AVANT_MODE"; regler_env V17_DEMO_ONLY "$AVANT_SEUL"
      echo -e "${R}✖ Mode démo non activé : la v17 garde son réglage précédent ($AVANT_MODE).${N}"
      exit 1
    fi ;;
  v17-fictif)
    [ "$(lire_env V17_MODE paper)" = demo ] && en_bots ".venv/bin/python -c 'from v17_ops import rapport; rapport.avertir_positions(\"demo\")'"
    regler_env V17_MODE paper; regler_env V17_DEMO_ONLY 0
    service_v17 && echo -e "${V}v17 revenue au portefeuille fictif (vrais prix, aucun ordre Binance).${N}" ;;
  v17-rapprochement)
    en_bots ".venv/bin/python -c 'from v17_ops import rapport; print(rapport.rapprochement())'" ;;
  v17-debloquer)
    en_bots ".venv/bin/python -c 'from v17_ops import rapport; print(rapport.rapprochement())'"
    read -r -p "As-tu vérifié l'ordre et le solde dans Binance ? Tape exactement JE CONFIRME : " OK
    [ "$OK" = "JE CONFIRME" ] || { echo "Annulé : la v17 reste bloquée."; exit 1; }
    en_bots ".venv/bin/python -c 'from v17_ops import rapport; print(rapport.debloquer())'" ;;
  v17-arreter)
    systemctl disable --now $SERVICE_V17 > /dev/null 2>&1; echo -e "${J}Moteur v17 arrêté (le bot principal continue).${N}" ;;
  v17-symboles)
    LISTE="$(echo "${2:-}" | tr '[:lower:]' '[:upper:]' | tr -d ' ')"
    [[ "$LISTE" =~ ^[A-Z0-9]+/USDT(,[A-Z0-9]+/USDT)*$ ]] || { echo "Usage : bots v17-symboles BTC/USDT,ETH/USDT,SOL/USDT"; exit 1; }
    regler_env V17_SYMBOLS "$LISTE"
    echo -e "${V}Symboles suivis par la v17 : $LISTE${N}"
    systemctl is-enabled --quiet $SERVICE_V17 2> /dev/null && systemctl restart $SERVICE_V17 && echo "Moteur v17 redémarré." ;;
  v17-api-demarrer)
    service_v17_api && echo -e "${V}API v17 en marche sur 127.0.0.1:$(lire_env V17_API_PORT 8080) (lecture seule).${N}
Depuis le téléphone : Termius > Port Forwarding > Local, port $(lire_env V17_API_PORT 8080) vers 127.0.0.1:$(lire_env V17_API_PORT 8080),
puis dans le navigateur : http://127.0.0.1:$(lire_env V17_API_PORT 8080)/state" ;;
  v17-api-arreter)
    systemctl disable --now $SERVICE_V17_API > /dev/null 2>&1; echo -e "${J}API v17 arrêtée.${N}" ;;
  increvable)
    # Réécrit toutes les unités avec la relance sans fin et redémarre ce qui était en service.
    service_principal; systemctl restart $SERVICE
    systemctl is-enabled --quiet $SERVICE_TR 2> /dev/null && service_tr
    relancer_v17_si_actif
    echo -e "${V}✔ Tous les services en place se relancent désormais seuls, sans limite (plantage, bot figé, redémarrage du serveur).${N}"
    echo "  Arrêt volontaire : bots arreter · bots v17-arreter · bots tr-arreter · bots marches-arreter · bots renseignement-arreter"
    systemctl --no-pager --plain list-units 'equipe-bots*' 2> /dev/null | head -n 12 ;;
  version)    V=$(ls "$DOSSIER"/VERSION_V*.txt 2>/dev/null | sort -V | tail -n 1); [ -n "$V" ] && cat "$V" || echo "version inconnue" ;;
  ip)         echo "Adresse IP du serveur : $(curl -sf --max-time 10 https://api.ipify.org)" ;;
  mettre-a-jour)
    LIEN="${2:-}"; [ -n "$LIEN" ] || { echo "Usage : bots mettre-a-jour /root/fichier.zip   (ou 'lien-du-zip')"; exit 1; }
    TMP=$(mktemp -d)
    if [ -f "$LIEN" ]; then
      # Zip déjà déposé sur le serveur (Termius > SFTP)
      unzip -q "$LIEN" -d "$TMP" || { echo -e "${R}Zip illisible : renvoie-le.${N}"; exit 1; }
    else
      ID=$(echo "$LIEN" | grep -oE '/d/[^/]+' | cut -d/ -f3)
      [ -n "$ID" ] && LIEN="https://drive.google.com/uc?export=download&id=$ID"
      LIEN="${LIEN/dl=0/dl=1}"
      curl -sL "$LIEN" -o "$TMP/maj.zip" && unzip -q "$TMP/maj.zip" -d "$TMP" \
        || { echo -e "${R}Téléchargement impossible : vérifie le lien.${N}"; exit 1; }
    fi
    NOUVEAU=$(dirname "$(find "$TMP" -name main.py -not -path '*/tests/*' | head -n 1)")
    [ -f "$NOUVEAU/main.py" ] || { echo -e "${R}Ce zip ne contient pas le bot.${N}"; exit 1; }
    SAUVE="/home/bots/ancienne-version-$(date +%Y%m%d-%H%M)"
    # Unité de signal actuelle : .env (v11) sinon config.py (v10 et avant)
    UNITE=$(lire_env TIMEFRAME_SIGNAL "")
    [ -n "$UNITE" ] || UNITE=$(grep -oE '^UNITE_BOUGIE = "[^"]+"' "$DOSSIER/config.py" | head -n 1 | cut -d'"' -f2)
    UNITE="${UNITE:-15m}"
    systemctl stop $SERVICE $SERVICE_TR $SERVICE_V17 $SERVICE_V17_API $SERVICE_MARCHES $SERVICE_RENS 2> /dev/null
    rsync -a --exclude archives --exclude .venv "$DOSSIER/" "$SAUVE/"
    rsync -a --exclude .env --exclude '*.db' --exclude '*.json' --exclude '*.jsonl' --exclude deblocages.csv \
      --exclude archives --exclude sauvegardes --exclude '*.log' "$NOUVEAU/" "$DOSSIER/"
    sed -i -E "s/^(UNITE_BOUGIE = )\"[^\"]*\"/\1\"$UNITE\"/" "$DOSSIER/config.py"
    # v11 lit l'unité de signal dans .env : on y reporte ton réglage s'il n'était pas 15m
    if [ "$UNITE" != 15m ] && ! grep -qE '^TIMEFRAME_SIGNAL=' "$DOSSIER/.env" 2>/dev/null; then
      regler_env TIMEFRAME_SIGNAL "$UNITE"; echo -e "${J}Ton unité de signal $UNITE est conservée (TIMEFRAME_SIGNAL dans .env).${N}"
    fi
    chown -R bots:bots "$DOSSIER"; install -m 755 "$DOSSIER/bots" /usr/local/bin/bots
    en_bots ".venv/bin/pip install -q -r requirements.txt"
    if en_bots ".venv/bin/python verifier.py"; then
      service_principal; systemctl start $SERVICE; service_tr; relancer_v17_si_actif
      echo -e "${V}✔ Mise à jour installée et vérifiée. Ancienne version gardée dans $SAUVE${N}"
      systemctl is-enabled --quiet $SERVICE_RENS 2> /dev/null || [ ! -f "$DOSSIER/renseignement.py" ] \
        || echo -e "${J}Pour déployer l'armée de renseignement : bots renseignement-demarrer${N}"
      systemctl is-enabled --quiet $SERVICE_MARCHES 2> /dev/null || [ ! -f "$DOSSIER/veille_marches.py" ] \
        || echo -e "${J}Pour lancer la veille marchés mondiaux : bots marches-demarrer${N}"
      systemctl is-enabled --quiet $SERVICE_V17 2> /dev/null || [ ! -d "$DOSSIER/v17_ops" ] \
        || echo -e "${J}Pour lancer le moteur v17 : bots v17-demarrer${N}"
    else
      rsync -a --delete --exclude archives --exclude .venv "$SAUVE/" "$DOSSIER/"; chown -R bots:bots "$DOSSIER"
      systemctl start $SERVICE; service_tr; relancer_v17_si_actif
      echo -e "${R}✖ La nouvelle version échoue aux tests : ancienne version remise en place.${N}"
    fi
    rm -rf "$TMP" ;;
  *)
    cat << AIDE
